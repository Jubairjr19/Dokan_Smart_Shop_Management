{
  "name": "dokan-backend",
  "version": "1.0.0",
  "description": "Dokan - Smart Shop Management Software: Express and Prisma REST API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:local": "node scripts/dev-local.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node src/utils/seed.js",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && node src/utils/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.3",
    "twilio": "^5.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.0.0"
  }
}
