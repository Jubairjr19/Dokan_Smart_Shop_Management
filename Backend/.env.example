# Copy this file to .env and fill in your values.

# PostgreSQL connection string. The database must already exist.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dokan?schema=public"

# Sign-in tokens. Use at least 32 characters. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while this placeholder is still here.
JWT_SECRET="replace-this-with-a-long-random-string-before-deploying"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development

# Allowed frontend origins, separated by commas.
CORS_ORIGIN="http://localhost:5173"

# Number of reverse proxies in front of this app (0 if none, 1 behind nginx).
TRUST_PROXY=0

# "Today" and the daily chart buckets use this time zone.
TZ="Asia/Dhaka"

# SMS: "simulated" sends nothing and only records the message.
# "live" sends through Twilio and needs the three values below.
SMS_MODE="simulated"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Shared secret for payment webhooks. Webhooks are rejected while this is empty.
PAYMENT_WEBHOOK_SECRET=""
